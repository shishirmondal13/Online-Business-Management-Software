rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == 'admin';
    }

    function canEdit() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (getUserData().role == 'admin' || getUserData().accessLevel == 'edit');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    match /{collection}/{docId} {
      function isTenantCollection() {
        return collection in [
          'mobile_stock', 'gadget_stock', 'transport_costs', 'sales',
          'customers', 'payments', 'capital', 'salary', 'expenses', 'employees',
          'investment_history'
        ];
      }

      allow read: if isTenantCollection() && isSignedIn();
      allow create, update, delete: if isTenantCollection() && canEdit();
    }
  }
}
